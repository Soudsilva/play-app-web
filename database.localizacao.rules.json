{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      ".read": "auth != null && root.child('permissoes').child(auth.uid).child('administrador').val() === true",
      ".indexOn": ["email"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('permissoes').child(auth.uid).child('administrador').val() === true || (auth.uid === $uid && newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'nome', 'email', 'atualizadoEm'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150 && (auth.uid !== $uid || root.child('permissoes').child(auth.uid).child('administrador').val() === true || newData.val() === auth.token.name)"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254 && (auth.uid !== $uid || root.child('permissoes').child(auth.uid).child('administrador').val() === true || newData.val() === auth.token.email)"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "permissoes": {
      ".read": "auth != null && root.child('permissoes').child(auth.uid).child('administrador').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('permissoes').child(auth.uid).child('administrador').val() === true",
        ".validate": "newData.hasChildren(['administrador', 'localizacao_gestor'])",
        "administrador": {
          ".validate": "newData.isBoolean()"
        },
        "localizacao_gestor": {
          ".validate": "newData.isBoolean()"
        },
        "$permissao": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "modulos": {
      "localizacao": {
        "por_usuario": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('permissoes').child(auth.uid).child('localizacao_gestor').val() === true)",
            ".write": "auth != null && auth.uid === $uid && data.child('solicitacao_atual').child('status').val() === 'pendente' && newData.child('solicitacao_atual').child('id').val() === data.child('solicitacao_atual').child('id').val() && newData.child('solicitacao_atual').child('usuarioUid').val() === data.child('solicitacao_atual').child('usuarioUid').val() && newData.child('solicitacao_atual').child('colaboradorId').val() === data.child('solicitacao_atual').child('colaboradorId').val() && newData.child('solicitacao_atual').child('colaboradorNome').val() === data.child('solicitacao_atual').child('colaboradorNome').val() && newData.child('solicitacao_atual').child('solicitadoPorUid').val() === data.child('solicitacao_atual').child('solicitadoPorUid').val() && newData.child('solicitacao_atual').child('solicitadoPorNome').val() === data.child('solicitacao_atual').child('solicitadoPorNome').val() && newData.child('solicitacao_atual').child('solicitadoEmCliente').val() === data.child('solicitacao_atual').child('solicitadoEmCliente').val() && newData.child('solicitacao_atual').child('solicitadoEmServidor').val() === data.child('solicitacao_atual').child('solicitadoEmServidor').val() && (newData.child('solicitacao_atual').child('status').val() === 'respondida' || newData.child('solicitacao_atual').child('status').val() === 'permissao_negada')",
            ".validate": "newData.hasChildren(['solicitacao_atual']) && (auth.uid !== $uid || (newData.child('solicitacao_atual').child('status').val() === 'permissao_negada' && newData.child('historico').child('mais_recente').child('solicitacaoId').val() === data.child('historico').child('mais_recente').child('solicitacaoId').val() && newData.child('historico').child('anterior').child('solicitacaoId').val() === data.child('historico').child('anterior').child('solicitacaoId').val()) || (newData.child('solicitacao_atual').child('status').val() === 'respondida' && newData.child('historico').child('mais_recente').child('solicitacaoId').val() === data.child('solicitacao_atual').child('id').val() && newData.child('historico').child('mais_recente').child('usuarioUid').val() === $uid && newData.child('historico').child('mais_recente').child('colaboradorId').val() === data.child('solicitacao_atual').child('colaboradorId').val() && newData.child('historico').child('mais_recente').child('colaboradorNome').val() === data.child('solicitacao_atual').child('colaboradorNome').val()))",
            "solicitacao_atual": {
              ".write": "auth != null && root.child('permissoes').child(auth.uid).child('localizacao_gestor').val() === true",
              ".validate": "newData.hasChildren(['id', 'status', 'usuarioUid', 'colaboradorId', 'colaboradorNome', 'solicitadoPorUid', 'solicitadoPorNome', 'solicitadoEmCliente', 'solicitadoEmServidor'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "status": {
                ".validate": "newData.isString() && (newData.val() === 'pendente' || newData.val() === 'respondida' || newData.val() === 'permissao_negada')"
              },
              "usuarioUid": {
                ".validate": "newData.isString() && newData.val() === $uid"
              },
              "colaboradorId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
              },
              "colaboradorNome": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
              },
              "solicitadoPorUid": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
              },
              "solicitadoPorNome": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
              },
              "solicitadoEmCliente": {
                ".validate": "newData.isNumber()"
              },
              "solicitadoEmServidor": {
                ".validate": "newData.isNumber()"
              },
              "respondidaEmCliente": {
                ".validate": "newData.isNumber()"
              },
              "respondidaEmServidor": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "historico": {
              "$posicao": {
                ".validate": "($posicao === 'mais_recente' || $posicao === 'anterior') && newData.hasChildren(['solicitacaoId', 'usuarioUid', 'colaboradorId', 'colaboradorNome', 'latitude', 'longitude', 'precisaoMetros', 'qualidade', 'origem', 'capturadaEm', 'recebidaEmCliente', 'recebidaEmServidor']) && ($posicao !== 'mais_recente' || (newData.child('solicitacaoId').val() === root.child('modulos').child('localizacao').child('por_usuario').child($uid).child('solicitacao_atual').child('id').val() && newData.child('usuarioUid').val() === $uid && newData.child('colaboradorId').val() === root.child('modulos').child('localizacao').child('por_usuario').child($uid).child('solicitacao_atual').child('colaboradorId').val() && newData.child('colaboradorNome').val() === root.child('modulos').child('localizacao').child('por_usuario').child($uid).child('solicitacao_atual').child('colaboradorNome').val()))",
                "solicitacaoId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                },
                "usuarioUid": {
                  ".validate": "newData.isString() && newData.val() === $uid"
                },
                "colaboradorId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
                },
                "colaboradorNome": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
                },
                "latitude": {
                  ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
                },
                "longitude": {
                  ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
                },
                "precisaoMetros": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "qualidade": {
                  ".validate": "newData.isString() && (newData.val() === 'alta' || newData.val() === 'media' || newData.val() === 'aproximada')"
                },
                "origem": {
                  ".validate": "newData.isString() && newData.val() === 'dispositivo'"
                },
                "capturadaEm": {
                  ".validate": "newData.isNumber()"
                },
                "recebidaEmCliente": {
                  ".validate": "newData.isNumber()"
                },
                "recebidaEmServidor": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
